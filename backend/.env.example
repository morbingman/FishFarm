NODE_ENV=development
PORT=4000

# Supabase transaction pooler (runtime). Keep pgbouncer=true for Prisma.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
# Supabase direct connection (Prisma migrations and seed).
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-32-bytes-of-hex
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
SESSION_IDLE_MINUTES=30

# Firebase project used to verify Firebase Authentication ID tokens.
FIREBASE_PROJECT_ID=fishfarm-6f91e

CORS_ORIGINS=http://localhost:8443,http://127.0.0.1:8443,http://localhost:5173,http://127.0.0.1:5173

# Transactional email (https://resend.com). Use a verified domain in production.
RESEND_API_KEY=re_replace-with-a-send-only-api-key
MAIL_FROM="FishFarm <onboarding@resend.dev>"

# Cloudinary signed uploads. Never expose API_SECRET to the frontend.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
