# Save this file as backend/.env and enter your real values.
# ENV_FILE can point to another file (absolute path or relative to backend/).
# Server environment variables take precedence over file values.
# Encode special characters in database passwords, e.g. @ -> %40, # -> %23.
# Supabase: DATABASE_URL = transaction pooler 6543; DIRECT_URL = session pooler 5432
# or a direct database connection reachable from your host.
NODE_ENV=development
PORT=4000

# Supabase transaction pooler (runtime). Keep pgbouncer=true for Prisma.
DATABASE_URL="postgresql://fishfarm:fishfarm@localhost:5432/fishfarm?schema=public"
# Supabase direct connection (Prisma migrations and seed).
DIRECT_URL="postgresql://fishfarm:fishfarm@localhost:5432/fishfarm?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
SESSION_IDLE_MINUTES=30

CORS_ORIGINS=http://localhost:8443,http://127.0.0.1:8443,http://localhost:5173,http://127.0.0.1:5173

# Transactional email (https://resend.com). Use a verified domain in production.
RESEND_API_KEY=
MAIL_FROM="FishFarm <noreply@example.com>"

# Cloudinary signed uploads. Never expose API_SECRET to the frontend.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional server-only overrides; defaults are defined in src/auth/default-admin.ts.
# DEFAULT_ADMIN_EMAIL=admin@fish.com
# DEFAULT_ADMIN_PASSWORD=12345

# Same Web client ID as frontend VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
