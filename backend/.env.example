NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://fishfarm:fishfarm@localhost:5432/fishfarm?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-32-bytes-of-hex
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
SESSION_IDLE_MINUTES=30

CORS_ORIGINS=http://localhost:8443,http://127.0.0.1:8443,http://localhost:5173,http://127.0.0.1:5173
