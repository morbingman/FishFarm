# Local development: Vite proxies /api to http://localhost:4000/v1.
VITE_API_URL=/api
API_PROXY_TARGET=http://localhost:4000

# Separate production frontend/backend: set this BEFORE npm run build.
# VITE_API_URL=https://your-backend.example.com/v1
# The backend must allow your frontend origin in CORS_ORIGINS.
# Never place passwords, DATABASE_URL or JWT secrets in VITE_* variables.

# Google Identity Services Web client ID, also set as GOOGLE_CLIENT_ID in BE.
VITE_GOOGLE_CLIENT_ID=
